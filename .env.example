# ════════════════════════════════════════════════════
# TalentBridge Backend — Environment Variables
# Copy this file to .env and fill in your values
# ════════════════════════════════════════════════════

# ── Database (Docker Compose defaults) ──────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=talentbridge
DB_USERNAME=talentbridge
DB_PASSWORD=talentbridge123

# ── JWT ─────────────────────────────────────────────
# IMPORTANT: Change this in production! Must be 256+ bits (32+ chars)
JWT_SECRET=talentbridge-change-this-in-production-must-be-at-least-256-bits-long
JWT_EXPIRATION=86400000       # 24 hours in ms
JWT_REFRESH_EXPIRATION=604800000  # 7 days in ms

# ── OpenAI ──────────────────────────────────────────
# Get your key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-api-key-here

# ── GitHub OAuth App ─────────────────────────────────
# Create at: https://github.com/settings/apps/new
# Callback URL: http://localhost:3000/github/callback
GITHUB_CLIENT_ID=your-github-oauth-app-client-id
GITHUB_CLIENT_SECRET=your-github-oauth-app-client-secret
GITHUB_REDIRECT_URI=http://localhost:3000/github/callback

# ── File Storage ────────────────────────────────────
# Set USE_LOCAL_STORAGE=false to use AWS S3
USE_LOCAL_STORAGE=true
LOCAL_STORAGE_PATH=./uploads

# AWS S3 (only needed if USE_LOCAL_STORAGE=false)
AWS_ACCESS_KEY=
AWS_SECRET_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET=talentbridge-files

# ── Email (SendGrid) ─────────────────────────────────
MAIL_HOST=smtp.sendgrid.net
MAIL_USERNAME=apikey
MAIL_PASSWORD=your-sendgrid-api-key
FROM_EMAIL=noreply@talentbridge.com

# ── App ──────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000
SERVER_PORT=8080

# ── Party Size Limits ────────────────────────────────
PARTY_MIN_SIZE=2
PARTY_MAX_SIZE=3
