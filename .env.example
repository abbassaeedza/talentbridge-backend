# TalentBridge Backend Environment Variables
# Copy this file to .env and fill in your values

# Database (Docker Compose defaults)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=talentbridge
DB_USERNAME=talentbridge
DB_PASSWORD=talentbridge123
DB_SSL_MODE=disable

# JWT
# IMPORTANT: Change this in production! Must be 256+ bits (32+ chars)
JWT_SECRET=talentbridge-change-this-in-production-must-be-at-least-256-bits-long
# 24 hours in milliseconds
JWT_EXPIRATION=86400000
# 7 days in milliseconds
JWT_REFRESH_EXPIRATION=604800000

# OpenAI
# Get your key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-api-key-here
N8N_AI_WEBHOOK_URL=
N8N_WEBHOOK_SECRET=

# GitHub OAuth App
# Create at: https://github.com/settings/apps/new
# Callback URL: http://localhost:3000/github/callback
GITHUB_CLIENT_ID=your-github-oauth-app-client-id
GITHUB_CLIENT_SECRET=your-github-oauth-app-client-secret
GITHUB_REDIRECT_URI=http://localhost:3000/github/callback

# File Storage
# Local development fallback
LOCAL_STORAGE_PATH=./uploads

# Supabase Storage (set all three in production)
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_STORAGE_BUCKET=talentbridge-files

# Email (Resend)
# Testing sender: TalentBridge <onboarding@resend.dev>
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# App
FRONTEND_URL=http://localhost:3000
SERVER_PORT=8080
APP_DEMO_MODE=true
APP_SEED_COORDINATOR_EMAIL=coordinator@talentbridge.com
APP_SEED_COORDINATOR_PASSWORD=change-this-before-deployment

# Party Size Limits
PARTY_MIN_SIZE=2
PARTY_MAX_SIZE=3
